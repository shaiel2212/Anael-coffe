{
  "name": "cafe-management-backend",
  "version": "1.0.0",
  "description": "Backend for cafe management platform",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "cross-env NODE_ENV=development npx sequelize-cli db:migrate",
    "migrate:undo": "cross-env NODE_ENV=development npx sequelize-cli db:migrate:undo:all",
    "seed": "cross-env NODE_ENV=development npx sequelize-cli db:seed:all",
    "test": "jest --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.12.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.2",
    "qrcode": "^1.5.3",
    "sequelize": "^6.37.1",
    "uuid": "^9.0.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.0",
    "sequelize-cli": "^6.6.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  }
}
